# Datos de conexión a tu Postgres local (base "agrofresh", esquema "lab")
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrofresh
DB_USER=postgres
DB_PASSWORD=

# Orígenes permitidos para CORS (el frontend corriendo con npm run dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Carpeta donde el módulo Storage guarda los archivos subidos (ruta de Windows
# en el servidor de AgroFresh). Si no se define, usa una carpeta "storage"
# junto al backend.
STORAGE_DIR=C:\Users\Servidor Agrofresh\Documents\Sistemas\SRO\Storage
