# ──────────────────────────────────────────────
# OPCIÓN A: URL completa (Neon, Supabase, Render)
# ──────────────────────────────────────────────
# DATABASE_URL=postgresql://usuario:contraseña@host/nombre_bd?sslmode=require

# ──────────────────────────────────────────────
# OPCIÓN B: parámetros individuales (desarrollo local)
# ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrofresh
DB_USER=postgres
DB_PASSWORD=

# Orígenes permitidos para CORS (separados por coma)
# En producción: la URL de tu app en Vercel
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Carpeta donde Storage y Post Venta guardan los archivos subidos.
# En Render (testing): /tmp/agrofresh-storage  → efímero, se borra al reiniciar
# En servidor local Windows: C:\Users\...\Storage
STORAGE_DIR=storage

# ──────────────────────────────────────────────
# Gmail SMTP — proveedor activo de correo saliente
# Cuenta emisora: agrofreshreporthub@gmail.com
# Requisito: Verificación en 2 pasos activa en la cuenta Gmail.
# Genera la App Password en: myaccount.google.com/apppasswords
# ──────────────────────────────────────────────
GMAIL_APP_PASSWORD=
GMAIL_ACCOUNT=agrofreshreporthub@gmail.com
