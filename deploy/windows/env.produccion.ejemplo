# =============================================================================
# CONFIGURACIÓN DEL BACKEND EN EL SERVIDOR DE LA OFICINA
#
# Copiar a  backend\.env  y completar lo que está marcado.
# =============================================================================

# ── Base de datos ────────────────────────────────────────────────────────────
# OJO: DATABASE_URL tiene prioridad sobre todo lo demás. Se deja comentada a
# propósito: si se activa, el backend vuelve a escribir en Neon (lento y con
# límites) en vez de en el PostgreSQL de este equipo.
# DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrofresh
DB_USER=postgres
DB_PASSWORD=CAMBIAR_POR_LA_CLAVE_REAL

# ── Frontend ─────────────────────────────────────────────────────────────────
# El navegador bloquea las respuestas si la URL de Vercel no está acá.
# Sin la barra final. Se pueden poner varias separadas por coma.
CORS_ORIGINS=https://agrofresh-report-hub.vercel.app

# ── Archivos ─────────────────────────────────────────────────────────────────
# Disco real del servidor: lo que se sube ya no se pierde en cada despliegue.
STORAGE_DIR=C:\AgroFresh\storage

# ── Cloudflare R2 ────────────────────────────────────────────────────────────
# Se mantiene aunque los archivos ahora vivan en disco: es donde van las copias
# de respaldo de la base, fuera de este equipo.
R2_ENDPOINT_URL=https://TU_CUENTA.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=agrofresh-storage

# ── Correo ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=
